# SchemeSathi Environment Configuration

# Core Modes
MOCK_LLM=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local LLM (Ollama)
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0

# Multilingual Embeddings & Vector Store
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMADB_DIR=data/chromadb
RETRIEVAL_TOP_K=5

# SQLite Database
SQLITE_DB_PATH=data/sqlite/schemesathi.db

# Policy & Thresholds
CRITIC_MIN_GROUNDEDNESS=0.85
MAX_QUESTIONS_PER_TURN=2
ACTION_EXPIRY_MINUTES=30
APPOINTMENT_MIN_LEAD_HOURS=24
GRIEVANCE_SLA_WORKING_DAYS=2

# Server Configuration
HOST=0.0.0.0
PORT=8000

